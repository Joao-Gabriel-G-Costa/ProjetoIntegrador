                      <Color blue="ff" green="ff" red="ff" type="rgb"/>
                    </Property>
                    <Property name="text" type="java.lang.String" value="Esta tela tem como objetivo apresentar o controle das movimenta&#xe7;&#xf5;es financeiras registradas no sistema, permitindo a an&#xe1;lise de despesas associadas aos ve&#xed;culos cadastrados.&#xa;&#xa;O usu&#xe1;rio pode consultar as movimenta&#xe7;&#xf5;es por per&#xed;odo (m&#xea;s e ano), facilitando o acompanhamento de gastos, organiza&#xe7;&#xe3;o administrativa e apoio &#xe0; tomada de decis&#xf5;es."/>
                  </Properties>
                </Component>
